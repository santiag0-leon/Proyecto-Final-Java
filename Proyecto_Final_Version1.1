//1
      public ArrayList<Proyecto> registrarProyecto(ArrayList<Proyecto> losProyectos){
        boolean entradaInvalida = false;
        String msgEntrasInvalidas = "Causas:\n";

        String codigo = generarCodigoProyecto(losProyectos);
        String titulo = null;
        LocalDate fechaInicio = null;
        String unidadDuracion = null;
        byte duracionEstimada = 0;

        titulo = jTextFieldTitulo.getText();
        if(titulo.isEmpty()){
            msgEntrasInvalidas += "Título: entrada inválida, valor vacío \n";
            entradaInvalida = true;
        } else if(titulo.isBlank()){
            msgEntrasInvalidas += "Título: entrada inválida, valor vacío \n";
            entradaInvalida = true;
        } else if(titulo.length() < 20){
            msgEntrasInvalidas += "Título: entrada inválida, longitud incorrecta \n";
            entradaInvalida = true;
        } else if(titulo.length() > 100){
            msgEntrasInvalidas += "Título: entrada inválida, longitud incorrecta \n";
            entradaInvalida = true;
        }

        try{
            fechaInicio = LocalDate.parse(jTextFieldFechaInicio.getText());
        } catch(DateTimeException ex){
            msgEntrasInvalidas += "Fecha de inicio: entrada inválida, formato incorrecto " + ex.getMessage() + "\n";
            entradaInvalida = true;
        }

        unidadDuracion = jComboBoxUnidadDuracion.getSelectedItem().toString().toUpperCase();
        if(!unidadDuracion.equals("SEMANAS") && !unidadDuracion.equals("MESES") && !unidadDuracion.equals("AÑOS")){
            msgEntrasInvalidas += "     - Unidad de duración: entrada inválida, valor incorrecto.\n";
            entradaInvalida = true;
        }

        try{
            duracionEstimada = Byte.parseByte(jTextFieldDuracionEstimada.getText());
            switch(unidadDuracion){
                case "SEMANAS":
                    if(duracionEstimada < 1){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    } else if(duracionEstimada > 3){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    }
                    break;
                case "MESES":
                    if(duracionEstimada < 1){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    } else if(duracionEstimada > 35){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    } else if(duracionEstimada == 12){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    } else if(duracionEstimada == 24){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    }
                    break;
                case "AÑOS":
                    if(duracionEstimada < 1){
                        msgEntrasInvalidas += "Duración estimada: entrada inválida, valor incorrecto \n";
                        entradaInvalida = true;
                    }
                    break;
            }
        } catch(NumberFormatException ex){
            msgEntrasInvalidas += "Duración estimada: entrada inválida, formato incorrecto " + ex.getMessage() + "\n";
            entradaInvalida = true;
        }

        Proyecto objeto = null;
        if(entradaInvalida){
            JOptionPane.showMessageDialog(null,"Operación fallida \n" + msgEntrasInvalidas, "REGISTRO", JOptionPane.ERROR_MESSAGE);
            return losProyectos;
        }

        objeto = new Proyecto(codigo, titulo, fechaInicio, unidadDuracion, duracionEstimada, null, null);

        losProyectos.add(objeto);
        JOptionPane.showMessageDialog(null,"Operación exitosa", "REGISTRO", JOptionPane.INFORMATION_MESSAGE);

        return losProyectos;
    }

    public static String generarCodigoProyecto(ArrayList<Proyecto> losProyectos){
        int anio = LocalDate.now().getYear();
        int consecutivo = losProyectos.size() + 1;
        String codigo = "";
        if(consecutivo < 10){
            codigo = anio + "-00" + consecutivo;
        } else if(consecutivo < 100){
            codigo = anio + "-0" + consecutivo;
        } else {
            codigo = anio + "-" + consecutivo;
        }
        return codigo;
    }

    //2
   public String consultarTodosProyectos(ArrayList<Proyecto> losProyectos){
        String resultado = "CONSULTA DE TODOS LOS PROYECTOS\n";
        if(losProyectos.isEmpty()) {
            resultado += "No hay proyectos registrados.";
            return resultado;
        }
        for(Proyecto objeto : losProyectos){
            resultado += objeto.toString();
            resultado += ", fecha de finalización=" + objeto.determinarFechaFinalizacion();
            resultado += "\n";
        }
        return resultado;
    }

    //3
    
    public String consultarProyectosEnCurso(ArrayList<Proyecto> losProyectos){
        String resultado = "CONSULTA DE PROYECTOS EN CURSO\n";
        if(losProyectos.isEmpty()) {
            resultado += "No hay proyectos registrados.";
            return resultado;
        }
        boolean proyectoExiste = false;
        for(Proyecto objeto : losProyectos){
            if(objeto.getEstado().toUpperCase().equals("EN CURSO")){
                proyectoExiste = true;
                resultado += objeto.toString();
                resultado += ", fecha de finalización=" + objeto.determinarFechaFinalizacion();
                resultado += "\n";
            }
        }
        if(!proyectoExiste) {
            resultado += "No hay proyectos en curso registrados.";
        }
        return resultado;
    }

    //4
    public String consultarPrimerProyecto(ArrayList<Proyecto> losProyectos){
        String resultado = "CONSULTA DEL PRIMER PROYECTO\n";
        if(losProyectos.isEmpty()) {
            resultado += "No hay proyectos registrados.";
            return resultado;
        }
        Proyecto objeto = losProyectos.getFirst();
        resultado += objeto.toString();
        resultado += ", fecha de finalización=" + objeto.determinarFechaFinalizacion();
        resultado += "\n";

        return resultado;
    } 
